{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-stock",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-stock",
      "database_id": "b8952fbd-7dc3-4b43-a4ea-f22c7de49771",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "LINE_LOGIN_CHANNEL_ID": "2011949463",
    "LIFF_ID": "2011949463-T5XLybr3"
  }
}
